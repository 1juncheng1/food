# ────────────────────────────────────────────────────────────
# 环境变量清单（模板）
#
# 本文件只提交变量名与说明，**绝不填真实值**。
#   本地开发：复制为 .env.local 后填入真实值（.env.local 已被 git 忽略）
#   部署上线：在部署平台按本清单逐个配置
#
# ★ 安全铁律
#   SUPABASE_SERVICE_ROLE_KEY 拥有绕过 RLS 的完整数据库权限。
#   任何情况下都不得给它加 NEXT_PUBLIC_ 前缀 —— 加了就会被
#   打进浏览器包，等于把整库权限公开。只有 NEXT_PUBLIC_ 前缀的
#   变量才会被内联到客户端，其余在客户端恒为 undefined。
# ────────────────────────────────────────────────────────────

# ── 必填：缺一不可 ──────────────────────────────────────────
# Supabase 项目地址
NEXT_PUBLIC_SUPABASE_URL=
# Supabase 匿名密钥（客户端可用）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 服务端管理密钥（绕过 RLS，禁止加 NEXT_PUBLIC_ 前缀）
SUPABASE_SERVICE_ROLE_KEY=
# AI 主力模型：缺了所有创作/分析/灵感能力不可用
DEEPSEEK_API_KEY=

# ── 可选：缺失时功能自动降级，不影响启动 ────────────────────
# 图片 OCR / 上传处理（缺失则图片相关能力降级）
SILICONFLOW_API_KEY=
# 联网搜索（缺失则市场分析跳过联网，仅用本地数据）
TAVILY_API_KEY=
# 分布式限流（缺失则退回单机内存限流，多实例部署时建议配置）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# AI 请求总超时预算 ms（5000-300000，缺省用内置值）
AI_TIMEOUT_BUDGET_MS=
# AI 并发上限（缺省用内置值）
AI_MAX_CONCURRENCY=
# 数据库直连串，仅 scripts/backup-db.mjs 备份脚本需要
SUPABASE_DB_URL=
