# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
desktop.ini

# vitest 报告产物（本地生成，不入库）
.vitest-report.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 例外：提交变量清单模板（只含变量名与说明，不含真实值），供部署时对照配置
!.env.example

# vercel
.vercel

# supabase local temp
supabase/.temp/

# IDE / agent local state
/.codebuddy/
/.trae/
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# 数据库备份产物（可能含全量用户数据，绝不入库）
/backups/
